# ── 构建产物 ─────────────────────────────────────────────
build/
.gradle/
.kotlin/
*.apk
*.aab
*.idsig
*.hprof
captures/

# ── 本地环境 ─────────────────────────────────────────────
local.properties
.idea/
*.iml
.DS_Store

# ── 抓包/临时文件 ────────────────────────────────────────
# ⚠️ .tmp 里有**未脱敏的真实抓包**（urp-schedule.json 含学号），绝不能进仓库
.tmp/
*.log

# ── 签名 ─────────────────────────────────────────────────
# 只放行 debug.keystore（那是 Android 通用的调试密钥，密码就是 "android"，
# 不含任何机密，但 release 签名需要它，所以跟着仓库走）。
# 任何正式签名密钥一律不进仓库。
*.keystore
*.jks
!debug.keystore

# ── OS ───────────────────────────────────────────────────
Thumbs.db
desktop.ini
