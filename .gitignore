# ── 构建产物 ─────────────────────────────────────────────
build/
.gradle/
.kotlin/
*.apk
*.aab
*.idsig
*.hprof
captures/

# ── 本地环境 ─────────────────────────────────────────────
local.properties
.idea/
*.iml
.DS_Store

# ── 抓包/临时文件 ────────────────────────────────────────
# ⚠️ .tmp 里有**未脱敏的真实抓包**（urp-schedule.json 含学号），绝不能进仓库
.tmp/
*.log

# ── 签名 ─────────────────────────────────────────────────
# 只放行 debug.keystore（那是 Android 通用的调试密钥，密码就是 "android"，
# 不含任何机密，但 release 签名需要它，所以跟着仓库走）。
# 任何正式签名密钥一律不进仓库。
*.keystore
*.jks
!debug.keystore

# ── OS ───────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── 工具运行态 / 会话面板（含真实学号姓名，绝不入库）──────
.dsh-ops/
在途/.dsh-ops/

# ── 构建日志（每次编译重生成的中间物）────────────────────
build-log.txt
build-log-utf8.txt
build-compile-log.txt
build-release-log.txt
build-done.txt
build-verify-log.txt
build-verify-done.txt
log-convert-done.txt

# ── 资产瘦身中间产物（源在 curriculum/asset/，这批是可重生成的产物）──
在途/curriculum/asset_squeezed/
build-done.txt
log-convert-done.txt

# ── 培养方案提取管线的中间产物（可复现，26MB）──────────────
# 保留 在途/curriculum/json（源数据）与 README/query.py；
# _work 里是脚本草稿与 txt 转储，用 tools/curriculum/pack.py 即可重跑
在途/curriculum/_work/
在途/curriculum/__pycache__/
# ── 构建/调试重定向垃圾（代理跑命令时留下的）──────────
null.txt
null*.txt
compile-out.txt
build-compile-log.txt
build-release-log.txt
build-verify-log.txt
build-log.txt
build-verify-done.txt
# 教师抓取的页面缓存（票 27：原始 HTML 不进仓库）
.cache/

# 真机验收截图（本地产物，不入库）
.shots/
在途/_shots/

# 一次性排查脚本与探针输出（历史遗留两枚已跟踪的 apk_probe.*，其余不入库）
在途/_work/*
!在途/_work/apk_probe.py
!在途/_work/apk_probe.txt

# ── 本机凭证留档（服务器口令/钥匙，绝不入库）───────────────
# 里面是 ssh 端口、审核页 basic auth、CMAP_ADMIN_KEY、遥测管理钥匙；
# 只在本机看，任何情况下都不要提交。
docs/_local/

# ── 大纲抓取的会话物（cookie / 验证码图 / 临时页，含 JSESSIONID 绝不入库）──
在途/curriculum/_collect/cookies.txt
在途/curriculum/_collect/jar_*.txt
在途/curriculum/_collect/captcha*.jpg
在途/curriculum/_collect/zoom_*.png
在途/curriculum/_collect/.tmp_*
在途/curriculum/_collect/__pycache__/
server/telemetry/__pycache__/
server/telemetry/data/
在途/curriculum/_collect/_probe_raw*.json
在途/.tmp_*

# ── 压包中间产物（成品已进 app/src/main/assets，这里只用于复现）──
在途/curriculum/asset/
在途/curriculum/json/pack/
